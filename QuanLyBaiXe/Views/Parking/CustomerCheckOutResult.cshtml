@model QuanLyBaiXe.Models.ParkingSession

@{
    ViewData["Title"] = "Kết quả nhận xe";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="mb-4">Kết quả nhận xe</h2>

            <div class="alert alert-success">
                Nhận xe thành công.
            </div>

            <div class="table-responsive">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 220px;">Biển số xe</th>
                        <td>@Model.Vehicle?.LicensePlate</td>
                    </tr>
                    <tr>
                        <th>Loại xe</th>
                        <td>@Model.Vehicle?.VehicleType</td>
                    </tr>
                    <tr>
                        <th>Tên chủ xe</th>
                        <td>@Model.Vehicle?.OwnerName</td>
                    </tr>
                    <tr>
                        <th>Số điện thoại</th>
                        <td>@Model.Vehicle?.PhoneNumber</td>
                    </tr>
                    <tr>
                        <th>Giờ vào</th>
                        <td>@Model.CheckInTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                    <tr>
                        <th>Giờ ra</th>
                        <td>@(Model.CheckOutTime.HasValue? Model.CheckOutTime.Value.ToString("dd/MM/yyyy HH:mm:ss") : "")</td>
                    </tr>
                    <tr>
                        <th>Phí gửi xe</th>
                        <td>@string.Format("{0:N0} đ", Model.Fee ?? 0)</td>
                    </tr>
                    <tr>
                        <th>Trạng thái</th>
                        <td>@Model.Status</td>
                    </tr>
                </table>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Parking" asp-action="CustomerReceive" class="btn btn-primary">
                    Tiếp tục
                </a>
                <a asp-controller="Home" asp-action="CustomerDashboard" class="btn btn-secondary">
                    Về dashboard
                </a>
            </div>
        </div>
    </div>
</div>