@model QuanLyBaiXe.Models.ParkingSession

@{
    ViewData["Title"] = "Kết quả xử lý mất vé";
}

<div class="page-shell">

    <div class="content-card">

        <div class="content-card-header">

            <div>
                <div class="page-kicker">QUẢN LÝ XE</div>

                <h2 class="page-title text-danger">
                    Kết quả xử lý mất vé
                </h2>

                <p class="page-description">
                    Thông tin phiên gửi xe sau khi ghi nhận mất vé.
                </p>
            </div>

        </div>

        <div class="content-card-body">

            <div class="table-responsive table-frame">

                <table class="table table-bordered detail-table">

                    <tbody>

                        <tr>
                            <th>Biển số xe</th>
                            <td>
                                @Model.Vehicle?.LicensePlate
                            </td>
                        </tr>

                        <tr>
                            <th>Loại xe</th>
                            <td>
                                @Model.Vehicle?.VehicleType
                            </td>
                        </tr>

                        <tr>
                            <th>Chủ xe</th>
                            <td>
                                @Model.Vehicle?.OwnerName
                            </td>
                        </tr>

                        <tr>
                            <th>Số điện thoại</th>
                            <td>
                                @Model.Vehicle?.PhoneNumber
                            </td>
                        </tr>

                        <tr>
                            <th>Giờ vào</th>
                            <td>
                                @Model.CheckInTime.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                        </tr>

                        <tr>
                            <th>Giờ ra</th>
                            <td>
                                @Model.CheckOutTime?.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                        </tr>

                        <tr>
                            <th>Phí xử lý</th>
                            <td class="fw-bold text-danger">
                                @string.Format("{0:N0} đ", Model.Fee)
                            </td>
                        </tr>

                        <tr>
                            <th>Trạng thái</th>
                            <td>
                                @Model.Status
                            </td>
                        </tr>

                        <tr>
                            <th>Ghi chú</th>
                            <td>
                                @Model.Note
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <div class="action-buttons">

                <a asp-action="CurrentVehicles"
                   class="btn btn-primary">
                    Quay lại danh sách xe đang gửi
                </a>

            </div>

        </div>

    </div>

</div>