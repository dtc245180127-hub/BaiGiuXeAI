@model QuanLyBaiXe.Models.Vehicle

@{
    ViewData["Title"] = "Gửi xe";
}

<div class="page-shell">

    <div class="content-card">

        <div class="content-card-header">

            <div>
                <div class="page-kicker">KHÁCH HÀNG</div>

                <h2 class="page-title">
                    Gửi xe
                </h2>

                <p class="page-description">
                    Nhập thông tin xe để thực hiện gửi xe.
                </p>
            </div>

        </div>

        <div class="content-card-body">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger soft-alert">

                    <strong>Không thể gửi xe</strong>

                    <div>
                        @ViewBag.Error
                    </div>

                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success soft-alert">

                    <strong>Thành công</strong>

                    <div>
                        @TempData["Success"]
                    </div>

                </div>
            }

            <form asp-action="CustomerCheckIn"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger validation-summary mb-3">
                </div>

                <div class="form-section">

                    <div class="form-section-title">
                        Thông tin xe
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="LicensePlate"
                                   class="form-label">
                                Biển số xe
                            </label>

                            <input asp-for="LicensePlate"
                                   class="form-control"
                                   placeholder="Nhập biển số xe" />

                            <span asp-validation-for="LicensePlate"
                                  class="text-danger field-validation">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="VehicleType"
                                   class="form-label">
                                Loại xe
                            </label>

                            <select asp-for="VehicleType"
                                    class="form-select">

                                <option value="">
                                    -- Chọn loại xe --
                                </option>

                                <option value="Xe máy">
                                    Xe máy
                                </option>

                                <option value="Ô tô">
                                    Ô tô
                                </option>

                            </select>

                            <span asp-validation-for="VehicleType"
                                  class="text-danger field-validation">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="OwnerName"
                                   class="form-label">
                                Tên chủ xe
                            </label>

                            <input asp-for="OwnerName"
                                   class="form-control"
                                   placeholder="Nhập tên chủ xe" />

                            <span asp-validation-for="OwnerName"
                                  class="text-danger field-validation">
                            </span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                                Số điện thoại
                            </label>

                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   placeholder="Nhập số điện thoại" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger field-validation">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="action-buttons">

                    <button type="submit"
                            class="btn btn-primary">
                        Gửi xe
                    </button>

                    <a asp-controller="Home"
                       asp-action="CustomerDashboard"
                       class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}