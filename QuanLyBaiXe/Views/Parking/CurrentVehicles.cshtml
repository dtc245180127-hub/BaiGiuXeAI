@model List<QuanLyBaiXe.Models.ParkingSession>

@{
    ViewData["Title"] = "Xe đang gửi";
}

<div class="container-fluid">
    <div class="content-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Danh sách xe đang gửi trong bãi</h2>
            <a asp-action="CheckIn" class="btn btn-primary">+ Nhập xe vào</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>STT</th>
                    <th>Biển số</th>
                    <th>Loại xe</th>
                    <th>Chủ xe</th>
                    <th>SĐT</th>
                    <th>Giờ vào</th>
                    <th>Trạng thái</th>
                    <th width="140">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@item.Vehicle?.LicensePlate</td>
                        <td>@item.Vehicle?.VehicleType</td>
                        <td>@item.Vehicle?.OwnerName</td>
                        <td>@item.Vehicle?.PhoneNumber</td>
                        <td>@item.CheckInTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>
                            <span class="badge bg-success">@item.Status</span>
                        </td>
                        <td>
                            <a asp-action="CheckOut" asp-route-id="@item.Id" class="btn btn-warning btn-sm mb-1">
                                Xử lý xe ra
                            </a>
                            <br />
                            <a asp-action="LostTicket" class="btn btn-danger btn-sm">
                                Mất vé
                            </a>
                        </td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">Hiện chưa có xe nào trong bãi.</div>
        }
    </div>
</div>