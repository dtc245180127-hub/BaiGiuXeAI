@model List<QuanLyBaiXe.Models.User>

@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="page-shell">

    <div class="content-card">

        <div class="content-card-header">
            <div>
                <div class="page-kicker">QUẢN TRỊ</div>

                <h2 class="page-title">
                    Quản lý tài khoản
                </h2>

                <p class="page-description">
                    Quản lý tài khoản người dùng và phân quyền truy cập hệ thống.
                </p>
            </div>

            <div class="header-actions">
                <a asp-action="Create"
                   class="btn btn-primary">
                    + Thêm tài khoản
                </a>
            </div>
        </div>

        <div class="content-card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success soft-alert">
                    <strong>Thành công</strong>
                    <div>@TempData["Success"]</div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger soft-alert">
                    <strong>Có lỗi xảy ra</strong>
                    <div>@TempData["Error"]</div>
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        👤
                    </div>

                    <div class="empty-state-title">
                        Chưa có tài khoản
                    </div>

                    <div class="empty-state-text">
                        Hiện chưa có tài khoản nào trong hệ thống.
                    </div>

                </div>
            }
            else
            {
                <div class="table-responsive table-frame">

                    <table class="table data-table align-middle">

                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Họ tên</th>
                                <th>Tên đăng nhập</th>
                                <th>Mật khẩu</th>
                                <th>Vai trò</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int stt = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @stt
                                    </td>

                                    <td>
                                        <strong>
                                            @item.FullName
                                        </strong>
                                    </td>

                                    <td>
                                        @item.Username
                                    </td>

                                    <td>
                                        @item.Password
                                    </td>

                                    <td>
                                        @item.Role?.RoleName
                                    </td>

                                    <td>
                                        <div class="table-actions">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-warning btn-sm">
                                                Sửa
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm">
                                                Xóa
                                            </a>

                                        </div>
                                    </td>

                                </tr>

                                stt++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>
</div>