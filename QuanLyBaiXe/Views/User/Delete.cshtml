@model QuanLyBaiXe.Models.User

@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="page-shell">

    <div class="content-card">

        <div class="content-card-header">

            <div>
                <div class="page-kicker">QUẢN TRỊ</div>

                <h2 class="page-title text-danger">
                    Xóa tài khoản
                </h2>

                <p class="page-description">
                    Kiểm tra lại thông tin trước khi xác nhận xóa tài khoản.
                </p>
            </div>

        </div>

        <div class="content-card-body">

            <div class="alert alert-warning soft-alert">
                <strong>Cảnh báo</strong>

                <div>
                    Bạn có chắc chắn muốn xóa tài khoản này không?
                    Hành động này có thể không thể hoàn tác.
                </div>
            </div>

            <div class="table-responsive table-frame">

                <table class="table table-bordered detail-table">

                    <tbody>

                        <tr>
                            <th>Họ tên</th>
                            <td>
                                @Model.FullName
                            </td>
                        </tr>

                        <tr>
                            <th>Tên đăng nhập</th>
                            <td>
                                @Model.Username
                            </td>
                        </tr>

                        <tr>
                            <th>Mật khẩu</th>
                            <td>
                                @Model.Password
                            </td>
                        </tr>

                        <tr>
                            <th>Vai trò</th>
                            <td>
                                @Model.Role?.RoleName
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <form asp-action="Delete"
                  method="post">

                <input type="hidden"
                       asp-for="Id" />

                <div class="action-buttons">

                    <button type="submit"
                            class="btn btn-danger">
                        Xác nhận xóa
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Hủy
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>