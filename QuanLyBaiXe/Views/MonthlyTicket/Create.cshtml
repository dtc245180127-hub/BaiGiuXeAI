@model QuanLyBaiXe.Models.MonthlyTicket
@using QuanLyBaiXe.Models

@{
    ViewData["Title"] = "Tạo vé tháng";
    var vehicles = ViewBag.Vehicles as List<Vehicle>;
}

<div class="container-fluid">
    <div class="card dashboard-card p-4">
        <h2 class="mb-4">Tạo vé tháng</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Chọn xe</label>
                <select asp-for="VehicleId" class="form-select">
                    <option value="">-- Chọn biển số xe --</option>
                    @if (vehicles != null)
                    {
                        foreach (var v in vehicles)
                        {
                            <option value="@v.Id">@v.LicensePlate - @v.VehicleType</option>
                        }
                    }
                </select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OwnerName" class="form-label">Tên chủ vé</label>
                <input asp-for="OwnerName" class="form-control" />
                <span asp-validation-for="OwnerName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartDate" class="form-label">Ngày bắt đầu</label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDate" class="form-label">Ngày hết hạn</label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu vé tháng</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}