@model QuanLyBaiXe.Models.MonthlyTicket

@{
    ViewData["Title"] = "Gia hạn vé tháng";
}

<div class="page-shell">
    <div class="content-card">

        <div class="content-card-header">
            <div>
                <div class="page-kicker">KHÁCH HÀNG</div>

                <h2 class="page-title">
                    Gia hạn vé tháng
                </h2>

                <p class="page-description">
                    Kiểm tra thông tin vé và chọn ngày hết hạn mới.
                </p>
            </div>
        </div>

        <div class="content-card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger soft-alert">
                    <strong>Có lỗi xảy ra</strong>
                    <div>@TempData["Error"]</div>
                </div>
            }

            <div class="table-responsive table-frame">

                <table class="table table-bordered detail-table">

                    <tbody>

                        <tr>
                            <th>Biển số xe</th>
                            <td>
                                @Model.Vehicle?.LicensePlate
                            </td>
                        </tr>

                        <tr>
                            <th>Loại xe</th>
                            <td>
                                @Model.Vehicle?.VehicleType
                            </td>
                        </tr>

                        <tr>
                            <th>Tên chủ vé</th>
                            <td>
                                @Model.OwnerName
                            </td>
                        </tr>

                        <tr>
                            <th>Số điện thoại</th>
                            <td>
                                @Model.PhoneNumber
                            </td>
                        </tr>

                        <tr>
                            <th>Ngày bắt đầu</th>
                            <td>
                                @Model.StartDate.ToString("dd/MM/yyyy")
                            </td>
                        </tr>

                        <tr>
                            <th>Ngày hết hạn hiện tại</th>
                            <td>
                                @Model.EndDate.ToString("dd/MM/yyyy")
                            </td>
                        </tr>

                        <tr>
                            <th>Giá hiện tại</th>
                            <td>
                                @string.Format("{0:N0} đ", Model.Price)
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

            <form asp-action="CustomerRenew" method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <div class="form-section">

                    <div class="form-section-title">
                        Thông tin gia hạn
                    </div>

                    <label for="newEndDate"
                           class="form-label">
                        Ngày hết hạn mới
                    </label>

                    <input type="date"
                           id="newEndDate"
                           name="newEndDate"
                           class="form-control"
                           required />

                </div>

                <div class="action-buttons">

                    <button type="submit"
                            class="btn btn-primary">
                        Gia hạn vé
                    </button>

                    <a asp-action="CustomerRenewList"
                       class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>