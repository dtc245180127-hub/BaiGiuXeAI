@model List<QuanLyBaiXe.Models.MonthlyTicket>

@{
    ViewData["Title"] = "Vé tháng sắp hết hạn";
}

<div class="page-shell">
    <div class="content-card">

        <div class="content-card-header">

            <div>
                <div class="page-kicker">VÉ THÁNG</div>

                <h2 class="page-title">
                    Vé tháng sắp hết hạn
                </h2>

                <p class="page-description">
                    Các vé tháng sẽ hết hạn trong vòng 7 ngày.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-secondary">
                Quay lại
            </a>

        </div>

        <div class="content-card-body">

            @if (Model.Count == 0)
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        ✓
                    </div>

                    <div class="empty-state-title">
                        Không có vé sắp hết hạn
                    </div>

                    <div class="empty-state-text">
                        Hiện không có vé tháng nào sắp hết hạn trong 7 ngày.
                    </div>

                </div>
            }
            else
            {
                <div class="table-responsive table-frame">

                    <table class="table data-table align-middle">

                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Biển số xe</th>
                                <th>Loại xe</th>
                                <th>Chủ vé</th>
                                <th>SĐT</th>
                                <th>Ngày hết hạn</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int stt = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @stt
                                    </td>

                                    <td>
                                        <span class="vehicle-plate">
                                            @item.Vehicle?.LicensePlate
                                        </span>
                                    </td>

                                    <td>
                                        @item.Vehicle?.VehicleType
                                    </td>

                                    <td>
                                        @item.OwnerName
                                    </td>

                                    <td>
                                        @item.PhoneNumber
                                    </td>

                                    <td>
                                        <strong>
                                            @item.EndDate.ToString("dd/MM/yyyy")
                                        </strong>
                                    </td>

                                    <td>
                                        <span class="status-badge status-warning">
                                            Sắp hết hạn
                                        </span>
                                    </td>

                                </tr>

                                stt++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>
</div>