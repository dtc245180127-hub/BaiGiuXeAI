@model List<QuanLyBaiXe.Models.MonthlyTicket>

@{
    ViewData["Title"] = "Danh sách vé tháng";
}

<div class="page-shell">
    <div class="content-card">
        <div class="content-card-header">
            <div>
                <div class="page-kicker">VÉ THÁNG</div>
                <h2 class="page-title">Danh sách vé tháng</h2>
                <p class="page-description">
                    Quản lý và theo dõi tình trạng các vé tháng.
                </p>
            </div>

            <div class="header-actions">
                <a asp-action="ExpiringSoon" class="btn btn-warning">
                    Sắp hết hạn
                </a>

                <a asp-action="Create" class="btn btn-primary">
                    + Tạo vé tháng
                </a>
            </div>
        </div>

        <div class="content-card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success soft-alert">
                    <strong>Thành công</strong>
                    <div>@TempData["Success"]</div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger soft-alert">
                    <strong>Có lỗi xảy ra</strong>
                    <div>@TempData["Error"]</div>
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon">🎫</div>

                    <div class="empty-state-title">
                        Chưa có vé tháng
                    </div>

                    <div class="empty-state-text">
                        Hiện chưa có vé tháng nào trong hệ thống.
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive table-frame">
                    <table class="table data-table align-middle">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Biển số xe</th>
                                <th>Loại xe</th>
                                <th>Chủ vé</th>
                                <th>SĐT</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày hết hạn</th>
                                <th>Giá vé</th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int stt = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@stt</td>

                                    <td>
                                        <span class="vehicle-plate">
                                            @item.Vehicle?.LicensePlate
                                        </span>
                                    </td>

                                    <td>
                                        @item.Vehicle?.VehicleType
                                    </td>

                                    <td>
                                        @item.OwnerName
                                    </td>

                                    <td>
                                        @item.PhoneNumber
                                    </td>

                                    <td>
                                        @item.StartDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.EndDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <strong>
                                            @string.Format("{0:N0} đ", item.Price)
                                        </strong>
                                    </td>

                                    <td>
                                        @if (item.Status == "ConHan")
                                        {
                                            <span class="status-badge status-success">
                                                Còn hạn
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-danger">
                                                Hết hạn
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <a asp-action="Renew"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">
                                            Gia hạn
                                        </a>
                                    </td>
                                </tr>

                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>