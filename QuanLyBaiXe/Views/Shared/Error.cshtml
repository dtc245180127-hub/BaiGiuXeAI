@model ErrorViewModel

@{
    ViewData["Title"] = "Lỗi hệ thống";
}

<div class="page-shell">

    <div class="content-card">

        <div class="content-card-header">

            <div>

                <div class="page-kicker">
                    HỆ THỐNG
                </div>

                <h2 class="page-title text-danger">
                    Đã xảy ra lỗi
                </h2>

                <p class="page-description">
                    Có lỗi xảy ra trong quá trình xử lý yêu cầu.
                </p>

            </div>

        </div>


        <div class="content-card-body">

            <div class="soft-alert soft-alert-danger">

                <strong>
                    Không thể hoàn thành yêu cầu.
                </strong>

                <div>
                    Đã xảy ra lỗi trong quá trình xử lý.
                    Vui lòng thử lại sau.
                </div>

            </div>


            @if (Model.ShowRequestId)
            {
                <div class="form-section">

                    <div class="form-section-title">
                        Thông tin yêu cầu
                    </div>

                    <div class="detail-table-wrapper">

                        <table class="table table-bordered detail-table">

                            <tbody>

                                <tr>

                                    <th>
                                        Request ID
                                    </th>

                                    <td>
                                        <code>@Model.RequestId</code>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>
            }


            <div class="form-section">

                <div class="form-section-title">
                    Development Mode
                </div>

                <p>
                    Chuyển sang môi trường
                    <strong>Development</strong>
                    sẽ hiển thị thông tin chi tiết hơn về lỗi
                    xảy ra trong quá trình xử lý.
                </p>

                <p>
                    Không nên bật môi trường
                    <strong>Development</strong>
                    khi triển khai hệ thống thực tế vì thông tin
                    chi tiết của exception có thể chứa dữ liệu
                    nhạy cảm và được hiển thị cho người dùng.
                </p>

                <p>
                    Để debug cục bộ, đặt biến môi trường
                    <strong>ASPNETCORE_ENVIRONMENT</strong>
                    thành
                    <strong>Development</strong>
                    rồi khởi động lại ứng dụng.
                </p>

            </div>

        </div>

    </div>

</div>