@model List<QuanLyBaiXe.Models.ActivityLog>

@{
    ViewData["Title"] = "Lịch sử thao tác";
}

<div class="container-fluid">
    <div class="content-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Lịch sử thao tác hệ thống</h2>
        </div>

        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>STT</th>
                    <th>Thời gian</th>
                    <th>Họ tên</th>
                    <th>Tên đăng nhập</th>
                    <th>Vai trò</th>
                    <th>Thao tác</th>
                    <th>Mô tả</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@item.UserFullName</td>
                        <td>@item.Username</td>
                        <td>@item.Role</td>
                        <td>@item.ActionName</td>
                        <td>@item.Description</td>
                    </tr>
                    stt++;
                }
            </tbody>
        </table>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">Chưa có lịch sử thao tác nào.</div>
        }
    </div>
</div>