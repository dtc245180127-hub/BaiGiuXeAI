@{
    ViewData["Title"] = "Dashboard khách hàng";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="mb-3">Dashboard khách hàng</h2>
            <p class="mb-2">Xin chào, <strong>@ViewBag.FullName</strong></p>
            <p class="text-muted">
                Khách hàng có thể sử dụng menu bên trái để thực hiện các chức năng:
                gửi xe, nhận xe, đăng ký vé tháng và gia hạn vé tháng.
            </p>
        </div>
    </div>
</div>