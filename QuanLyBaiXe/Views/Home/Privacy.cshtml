@{
    ViewData["Title"] = "Chính sách bảo mật";
}

<div class="page-shell">

    <div class="content-card">

        <div class="content-card-header">

            <div>

                <div class="page-kicker">
                    THÔNG TIN HỆ THỐNG
                </div>

                <h2 class="page-title">
                    Chính sách bảo mật
                </h2>

                <p class="page-description">
                    Thông tin về việc bảo vệ và sử dụng dữ liệu
                    trong hệ thống quản lý bãi xe.
                </p>

            </div>

        </div>


        <div class="content-card-body">

            <div class="form-section">

                <div class="form-section-title">
                    Bảo mật thông tin
                </div>

                <p>
                    Hệ thống quản lý bãi xe được xây dựng nhằm
                    hỗ trợ quản lý phương tiện, vé tháng,
                    doanh thu và các hoạt động vận hành của bãi xe.
                </p>

                <p>
                    Thông tin tài khoản và dữ liệu phát sinh
                    trong quá trình sử dụng hệ thống cần được
                    bảo vệ và chỉ được sử dụng cho mục đích
                    quản lý bãi xe.
                </p>

            </div>


            <div class="form-section">

                <div class="form-section-title">
                    Trách nhiệm người sử dụng
                </div>

                <p>
                    Người sử dụng có trách nhiệm bảo vệ thông tin
                    đăng nhập của mình và không chia sẻ tài khoản
                    cho người khác.
                </p>

            </div>

        </div>

    </div>

</div>